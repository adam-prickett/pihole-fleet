# Host port for the dashboard
DASHBOARD_PORT=3030

# Use the published image instead of building locally (then: docker compose pull)
# DASHBOARD_IMAGE=ghcr.io/adam-prickett/pihole-fleet:latest

# Dashboard login password (required; 12+ characters recommended)
DASHBOARD_PASSWORD=

# Hostnames / IPs you will use to open the dashboard, comma-separated (required)
ALLOWED_HOSTS=192.168.1.10,dashboard.lan

# Set if a reverse proxy sits in front (hop count or proxy subnet), otherwise leave false
TRUST_PROXY=false

# Pi-hole passwords (app passwords recommended), referenced in config.json as "env:NAME"
PIHOLE1_PASSWORD=
PIHOLE2_PASSWORD=

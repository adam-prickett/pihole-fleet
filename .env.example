# Optional. Copy to .env for `docker compose`, or add under the stack's
# "Environment variables" in Portainer. Nothing here is required: settings are
# managed from the dashboard (gear icon).

# Host port for the dashboard
DASHBOARD_PORT=3030
# Pin a release instead of tracking latest
# DASHBOARD_IMAGE=ghcr.io/adam-prickett/pihole-fleet:0.2.0

# Settings can also be fixed here; any set this way is locked in the settings page.
# To pass them into the container, uncomment the matching lines under `environment:`
# in docker-compose.yml (e.g.  ALLOWED_HOSTS: ${ALLOWED_HOSTS}).
# DASHBOARD_PASSWORD=
# ALLOWED_HOSTS=dashboard.lan,10.1.68.0/24
# TRUST_PROXY=false
# POLL_INTERVAL_MS=5000
# READ_ONLY=false
# SESSION_HOURS=12
# MAX_STREAMS=50

{
  "name": "pihole-dashboard",
  "version": "0.2.0",
  "description": "Live, unified dashboard for multiple Pi-hole instances",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "demo": "concurrently -k -n mock,server,web -c yellow,blue,magenta \"tsx server/mock-pihole.ts\" \"tsx watch server/index.ts --config config.demo.json\" \"vite\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node build/index.js",
    "preview:demo": "concurrently -k -n mock,server \"node build/mock-pihole.js\" \"node build/index.js --config config.demo.json\"",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "gts lint",
    "fix": "gts fix",
    "check": "npm run typecheck && npm run lint"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.1.0",
    "globals": "^14.0.0",
    "gts": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
